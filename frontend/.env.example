# ProofOfFunds Frontend — Environment Variables
# Copy this to .env.local and fill in the values after deploying the contract.

# Network: preview | testnet | local
VITE_NETWORK=preview

# Deployed contract address
# After running: npm run deploy -- --network preview
# Update this with the returned contract address
VITE_CONTRACT_ADDRESS=

# Midnight indexer URL
VITE_INDEXER_URL=https://indexer.preview.midnight.network
